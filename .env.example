# Telegram
BOT_TOKEN=
OWNER_CHAT_ID=

# Runtime
DATABASE_PATH=data/app.db
CONFIG_DIR=config
ASSETS_DIR=assets

# Google Sheets — grid calendar Лист1 (fail-closed if enabled but misconfigured)
GOOGLE_SHEETS_ENABLED=false
# Keep true on prod calendar until write path is explicitly approved
GOOGLE_SHEETS_READONLY=true
# Preferred: Apps Script Web App (LockService atomic reserve)
GAS_WEBAPP_URL=
GAS_WEBAPP_TOKEN=
# Or service account
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# Payment details — only after owner approve; never commit real values
PAYMENT_INSTRUCTIONS=

# Hold after approve (WAITING_PAYMENT)
HOLD_HOURS=24
HOLD_REMINDER_HOURS_BEFORE=4
HOLD_WATCH_INTERVAL_SEC=60
# Without passport photos, flag booking as incomplete for owner
REQUIRE_PASSPORT_PHOTOS=true

# Optional OpenAI text extraction. Keep disabled until API key, model and data handling are agreed.
# Only age, behavior and health text is sent; room/pricing/calendar never go to the model.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
