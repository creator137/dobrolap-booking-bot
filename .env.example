# Telegram
BOT_TOKEN=
OWNER_CHAT_ID=

# Runtime
DATABASE_PATH=data/app.db
CONFIG_DIR=config
ASSETS_DIR=assets

# Google Sheets — grid calendar Лист1 (fail-closed if enabled but misconfigured)
GOOGLE_SHEETS_ENABLED=false
# Keep true on prod calendar until write path is explicitly approved
GOOGLE_SHEETS_READONLY=true
# Preferred: Apps Script Web App (LockService atomic reserve)
GAS_WEBAPP_URL=
GAS_WEBAPP_TOKEN=
# Or service account
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# Payment details — only after owner approve; never commit real values
PAYMENT_INSTRUCTIONS=

# Optional LLM
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
